# Meeting Library — .env (preencher com suas proprias chaves)
HOST=0.0.0.0
PORT=8011
AUTH_SALT=<gerar aleatorio>
NOLOCAL=1
INVITE_CODE=<codigo de convite p/ registro>
DEFAULT_USER=admin
DEFAULT_PW=<senha do usuario padrao>
# Transcricao
ASSEMBLYAI_API_KEY=
# Supabase (dados/storage de frames) — opcional
SUPABASE_URL=
SUPABASE_KEY=
# IA (resumo/apresentacao) — usados pelos scripts
NOTION_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
