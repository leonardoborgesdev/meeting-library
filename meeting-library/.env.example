# ============ MEETING LIBRARY — o PAINEL (/opt/meeting-library/.env) ============
# App Python (scripts/server.py) que mostra as calls transcritas.

HOST=0.0.0.0
PORT=8011
AUTH_SALT=CHANGE_ME_random          # sal do hash de senha do login
INVITE_CODE=CHANGE_ME               # código pra criar conta no painel
NOLOCAL=0

# Transcrição/diarização de reforço (opcional) -> https://www.assemblyai.com
ASSEMBLYAI_API_KEY=CHANGE_ME

# Storage de mídia via Telegram (Teldrive) — opcional
TD_TOKEN=CHANGE_ME

# Sync do painel (opcional) — https://supabase.com
SUPABASE_URL=https://CHANGE_ME.supabase.co
