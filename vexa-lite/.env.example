# ================= VEXA CORE  (/opt/vexa-lite/.env) =================
# Copie para `.env` e preencha. NUNCA commite o .env real.

# Token admin da API Vexa — invente um forte:  openssl rand -hex 24
ADMIN_API_TOKEN=CHANGE_ME_random_hex_24

# Postgres (invente a senha; repita na DATABASE_URL)
POSTGRES_PASSWORD=CHANGE_ME_strong_password
DATABASE_URL=postgresql://vexa:CHANGE_ME_strong_password@postgres:5432/vexa

# Transcrição = Groq Whisper  ->  https://console.groq.com/keys  (chave gsk_...)
TRANSCRIPTION_SERVICE_URL=https://api.groq.com
TRANSCRIPTION_SERVICE_TOKEN=CHANGE_ME_groq_key_gsk
SKIP_TRANSCRIPTION_CHECK=1

# Storage (MinIO local incluso no compose)
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=vexa
MINIO_SECURE=false
S3_ENDPOINT=http://minio:9000
S3_BUCKET=vexa
S3_SECURE=false
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=us-east-1
