# ============ AUTOJOIN — QUAIS CALLS O BOT ENTRA (/opt/vexa-lite/autojoin.env) ============
#
#  >>>>>  ESTE ARQUIVO É A ÚNICA COISA QUE MUDA NUMA CÓPIA  <<<<<
#
#  O control.py vigia o Google Calendar DESTA conta, acha os links
#  meet.google.com das reuniões e manda o bot Vexa entrar.
#  Pra uma instância nova que entra em OUTRAS calls: basta trocar a conta
#  Google abaixo (Client ID/Secret/Refresh Token de outra conta).
#
# Como gerar:
#  1. https://console.cloud.google.com -> novo projeto -> ativar "Google Calendar API"
#  2. Credenciais -> OAuth client ID (tipo Desktop) -> pega CLIENT_ID e CLIENT_SECRET
#  3. Gera o REFRESH_TOKEN autorizando o scope calendar.readonly com a conta que
#     RECEBE as calls (OAuth playground ou script). É essa conta que define as calls.

GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REFRESH_TOKEN=CHANGE_ME

# API Vexa local (não muda)
VEXA_API_URL=http://localhost:8056
VEXA_API_KEY=CHANGE_ME_mesma_criada_na_vexa

LEAD_MIN=2        # entra na call quantos minutos antes do horário
POLL_SEC=60       # de quanto em quanto tempo checa o calendário
